// ============================================================
// La Hilda — Esquema de base de datos (PostgreSQL vía Prisma)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Railway inyecta esto automáticamente
}

// ------------------------------------------------------------
// CAMIONES
// ------------------------------------------------------------
model Camion {
  id        Int      @id @default(autoincrement())
  nombre    String
  color     String   @default("#4FD1C5")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chofer      Chofer?
  zonas       Zona[]
  pedidos     Pedido[]
  cierresCaja CierreCaja[]

  @@map("camiones")
}

// Login propio de cada camión (usuario/contraseña distintos) — editable por el admin
model Chofer {
  id           Int      @id @default(autoincrement())
  nombre       String
  usuario      String   @unique
  passwordHash String   @map("password_hash")
  camionId     Int      @unique @map("camion_id")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  camion Camion @relation(fields: [camionId], references: [id], onDelete: Cascade)

  @@map("choferes")
}

// Barrio/zona operativa de la empresa. "camionId" puede ser null: significa que la zona
// existe (la empresa reparte ahí) pero todavía no está asignada a ningún camión.
// "orden" define la secuencia de reparto dentro del camión que la tenga asignada.
model Zona {
  id       Int    @id @default(autoincrement())
  barrio   String @unique // un barrio pertenece a un solo camión (o a ninguno)
  orden    Int    @default(0)
  camionId Int?   @map("camion_id")

  camion   Camion?       @relation(fields: [camionId], references: [id], onDelete: SetNull)
  horarios HorarioZona[]

  @@index([camionId])
  @@map("zonas")
}

// Franjas aproximadas de reparto configuradas por el administrador para cada barrio.
// diaSemana usa el criterio de JavaScript/PostgreSQL: 1=lunes ... 5=viernes.
model HorarioZona {
  id         Int      @id @default(autoincrement())
  zonaId     Int      @map("zona_id")
  diaSemana  Int      @map("dia_semana")
  horaDesde  String   @map("hora_desde")
  horaHasta  String   @map("hora_hasta")
  cupoMaximo Int      @default(6) @map("cupo_maximo")
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  zona    Zona     @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@unique([zonaId, diaSemana, horaDesde, horaHasta])
  @@index([zonaId, diaSemana, activo])
  @@map("horarios_zona")
}

// ------------------------------------------------------------
// ADMINISTRADORES — usuario/contraseña propios, editables por el mismo admin
// ------------------------------------------------------------
model Admin {
  id           Int      @id @default(autoincrement())
  nombre       String
  usuario      String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("admins")
}

// ------------------------------------------------------------
// CONFIGURACIÓN GENERAL — fila única (id=1): acceso privado y datos para transferencias.
// ------------------------------------------------------------
model Configuracion {
  id                   Int    @id @default(1)
  claveAreaPrivada     String @default("") @map("clave_area_privada")
  transferenciaTitular String @default("") @map("transferencia_titular")
  transferenciaBanco   String @default("") @map("transferencia_banco")
  transferenciaAlias   String @default("") @map("transferencia_alias")
  transferenciaCbu     String @default("") @map("transferencia_cbu")
  transferenciaCuit    String @default("") @map("transferencia_cuit")
  direccionBase        String @default("") @map("direccion_base")
  latitudBase          Float? @map("latitud_base")
  longitudBase         Float? @map("longitud_base")

  @@map("configuracion")
}

// ------------------------------------------------------------
// CLIENTES
// ------------------------------------------------------------
enum TipoLugar {
  casa
  oficina
  empresa
}

// A qué segmento pertenece el pedido: define qué catálogo de productos ve el cliente.
enum SegmentoCliente {
  consumo_personal
  dispenser_frio_calor
  comercio_reventa
}

model Cliente {
  id        Int       @id @default(autoincrement())
  nombre    String
  telefono  String
  barrio    String
  calle     String
  tipo      TipoLugar @default(casa)
  pago      String // "Efectivo" | "Transferencia" — lo declarado por el cliente al pedir
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  pedidos Pedido[]

  @@index([barrio])
  @@map("clientes")
}

// ------------------------------------------------------------
// CATÁLOGO — separado en consumo personal, dispenser y comercio/reventa
// ------------------------------------------------------------
model Producto {
  id          Int             @id @default(autoincrement())
  nombre      String
  descripcion String          @default("")
  precio      Decimal         @db.Decimal(10, 2)
  activo      Boolean         @default(true)
  categoria   SegmentoCliente @default(consumo_personal)
  imagenKey   String?         @map("imagen_key")
  imagenMime  String?         @map("imagen_mime")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  items     PedidoItem[]
  variantes ProductoVariante[]

  @@index([categoria])
  @@map("productos")
}

// Escalas de compra para el catálogo mayorista. El precio es unitario para
// que caja, carga y reportes sigan contabilizando la mercadería real.
model ProductoVariante {
  id             Int      @id @default(autoincrement())
  productoId     Int      @map("producto_id")
  nombre         String
  cantidad       Int
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  activo         Boolean  @default(true)
  orden          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId, orden])
  @@map("producto_variantes")
}

// ------------------------------------------------------------
// PEDIDOS
// ------------------------------------------------------------
enum EstadoPedido {
  pendiente
  entregado
  no_atendido
}

model Pedido {
  id                    Int             @id @default(autoincrement())
  clienteId             Int             @map("cliente_id")
  camionId              Int             @map("camion_id")
  direccion             String
  barrio                String
  latitud               Float?
  longitud              Float?
  tipo                  TipoLugar
  segmento              SegmentoCliente @default(consumo_personal)
  pago                  String // método declarado por el cliente al pedir
  pagoConfirmado        String?         @map("pago_confirmado") // lo que el chofer confirma al entregar (puede diferir)
  fechaEntrega          DateTime        @map("fecha_entrega") @db.Date
  fechaEntregaOriginal  DateTime?       @map("fecha_entrega_original") @db.Date
  fechaReasignadaManual Boolean         @default(false) @map("fecha_reasignada_manual")
  horarioZonaId         Int?            @map("horario_zona_id")
  horaDesde             String?         @map("hora_desde")
  horaHasta             String?         @map("hora_hasta")
  notas                 String          @default("")
  notaAdmin             String          @default("") @map("nota_admin")
  notaCamion            String          @default("") @map("nota_camion")
  comprobanteKey        String?         @map("comprobante_key")
  comprobanteMime       String?         @map("comprobante_mime")
  comprobanteFecha      DateTime?       @map("comprobante_fecha")
  estado                EstadoPedido    @default(pendiente)
  reasignadoManual      Boolean         @default(false) @map("reasignado_manual")
  total                 Decimal         @db.Decimal(10, 2)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  camion      Camion       @relation(fields: [camionId], references: [id])
  horarioZona HorarioZona? @relation(fields: [horarioZonaId], references: [id], onDelete: SetNull)
  items       PedidoItem[]

  @@index([camionId, fechaEntrega])
  @@index([clienteId])
  @@index([fechaEntrega])
  @@index([horarioZonaId, fechaEntrega])
  @@map("pedidos")
}

model PedidoItem {
  id             Int     @id @default(autoincrement())
  pedidoId       Int     @map("pedido_id")
  productoId     Int?    @map("producto_id")
  productoNombre String  @map("producto_nombre")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@map("pedido_items")
}

// ------------------------------------------------------------
// CIERRE DE CAJA — rendición diaria por camión/repartidor.
// Los totales quedan congelados al cerrar para conservar el historial tal
// como fue entregado ese día, aunque luego se regularice un cobro atrasado.
// ------------------------------------------------------------
model CierreCaja {
  id                     Int       @id @default(autoincrement())
  camionId               Int       @map("camion_id")
  fecha                  DateTime  @db.Date
  cerrado                Boolean   @default(false)
  choferNombre           String    @default("") @map("chofer_nombre")
  pedidosEntregados      Int       @default(0) @map("pedidos_entregados")
  ventasTotal            Decimal   @default(0) @map("ventas_total") @db.Decimal(12, 2)
  efectivoCobrado        Decimal   @default(0) @map("efectivo_cobrado") @db.Decimal(12, 2)
  transferenciasCobradas Decimal   @default(0) @map("transferencias_cobradas") @db.Decimal(12, 2)
  pendienteCobro         Decimal   @default(0) @map("pendiente_cobro") @db.Decimal(12, 2)
  productosResumen       Json?     @map("productos_resumen")
  efectivoDeclarado      Decimal?  @map("efectivo_declarado") @db.Decimal(12, 2)
  observaciones          String    @default("")
  cerradoAt              DateTime? @map("cerrado_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  camion       Camion           @relation(fields: [camionId], references: [id], onDelete: Cascade)
  extracciones ExtraccionCaja[]

  @@unique([camionId, fecha])
  @@index([fecha])
  @@map("cierres_caja")
}

model ExtraccionCaja {
  id           Int      @id @default(autoincrement())
  cierreCajaId Int      @map("cierre_caja_id")
  monto        Decimal  @db.Decimal(12, 2)
  concepto     String
  responsable  String
  createdAt    DateTime @default(now()) @map("created_at")

  cierreCaja CierreCaja @relation(fields: [cierreCajaId], references: [id], onDelete: Cascade)

  @@index([cierreCajaId])
  @@map("extracciones_caja")
}

// ------------------------------------------------------------
// CALENDARIO — feriados u otros días excepcionales sin reparto.
// Sábados y domingos NO hace falta cargarlos acá: el sistema ya los excluye siempre
// (ver src/utils/diaHabil.js). Esta tabla es solo para días extra, como feriados.
// ------------------------------------------------------------
model DiaNoHabil {
  id     Int      @id @default(autoincrement())
  fecha  DateTime @unique @db.Date
  motivo String   @default("")

  @@map("dias_no_habiles")
}
